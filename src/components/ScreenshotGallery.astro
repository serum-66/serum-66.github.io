---
// Screenshots live at {media}/shot-NN.webp with a matching shot-NN-thumb.webp.
const { title, media, count } = Astro.props;
const shots = Array.from({ length: count }, (_, i) => `${media}/shot-${String(i + 1).padStart(2, '0')}`);
---
<section class="section game-about">
	<div class="container">
		<p class="eyebrow">SCREENSHOTS</p>
		<div class="screenshot-grid">
			{shots.map((shot, i) => (
				<a href={`${shot}.webp`} target="_blank" rel="noreferrer">
					<img src={`${shot}-thumb.webp`} alt={`${title} screenshot ${i + 1}`} loading="lazy" width="640" height="360" />
				</a>
			))}
		</div>
	</div>
</section>
