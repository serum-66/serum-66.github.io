---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
---
<BaseLayout>
	<section class="hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<!-- <div class="hero-mark"><img src="/assets/logo-icon.svg" alt="" /></div>
				<p class="kicker">SERUM 66 GAMES LAB</p> -->
				<h1>Games made to be <span>different.</span></h1>
				<p class="hero-lead">We’re an indie game development studio focused on experimentation, fun, and creating new experiences for players.</p>
				<div class="hero-actions">
					<a class="button button-primary" href="#games">Explore our games</a>
					<a class="button button-ghost" href="/about">About the studio</a>
				</div>
			</div>
			<!-- <div class="hero-visual" aria-hidden="true">
				<div class="lab-orb"></div>
				<div class="lab-ring ring-a"></div>
				<div class="lab-ring ring-b"></div>
				<div class="lab-label">FORMULA 66<br /><span>EXP: UNKNOWN</span></div>
			</div> -->
			<div class="hero-visual" id="heroVisual" aria-hidden="true">
				<div class="lab-orb"></div>
		
				<div class="orbit-axis axis-a">
					<div class="lab-ring ring-a"></div>
				</div>

				<div class="orbit-axis axis-b">
					<div class="lab-ring ring-b"></div>
				</div>

				<div class="orbit-axis axis-c">
					<div class="lab-ring ring-c"></div>
				</div>

				<!--<div class="orbit-axis axis-d">
					<div class="lab-ring ring-d"></div>
				</div> -->

				<div class="lab-label">FORMULA 66<br /><span>EXP: UNKNOWN</span></div>
			</div>
		</div>
	</section>

	<section class="statement section-tight">
		<div class="container statement-inner">
			<p class="eyebrow">OUR APPROACH</p>
			<h2 >Not ordinary games.<br /><span>New experiences.</span></h2>
			<p>We like the ideas that make us stop and say, “What if?” Our goal is to take those ideas, turn them into playable experiences, and make sure they’re a lot of fun along the way.</p>
		</div>
	</section>

	<section id="games" class="section games-section">
		<div class="container">
			<div class="section-heading">
				<div>
					<p class="eyebrow">CURRENT PROJECTS</p>
					<h2>In the lab</h2>
				</div>
				<!-- <p style="text-align:right;">Two projects are currently in production.</p> -->
			</div>
			<div class="games-grid">
				<GameCard
					title="Lucky's Scratch House"
					genre="Casual Sports Simulation"
					status="Pre-Release"
					description="A physics-based multiplayer bar hangout. Shoot pool, throw darts, and see what happens when you start messing with the place and its regulars."
					href="/games/luckys-scratch-house"
				/>
				<GameCard
					title="Heroes of Underhollow"
					genre="Tactical Roguelike"
					status="Pre-Release"
					description="A turn-based tactical roguelike where the battlefield is your weapon. Ignite oil, electrify water, and shove enemies into hazards."
					href="/games/heroes-of-underhollow"
				/>
				<GameCard
					title="Royal Guard"
					genre="Arcade Shoot 'em Up"
					status="In Production"
					description="A fast-paced arcade shooter with sharp action, satisfying destruction, and replayable runs."
					href="/games/royal-guard"
				/>
			</div>
		</div>
	</section>

	<section class="section about-strip">
		<div class="container split-layout">
			<div>
				<p class="eyebrow">ABOUT SERUM 66</p>
				<!-- <h2>A small studio with <span>big ideas.</span></h2> -->
				 <h2>Small studio. <br/><span>Big ideas.</span></h2> 
			</div>
			<div>
				<p>Serum 66 is an independent game development studio building hand-crafted takes on familiar formats. Step into the lab to see how small, deliberate tweaks can turn classic mechanics into something fresh.</p>
				<a class="text-link" href="/about">Learn more about us <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	<section id="contact" class="section contact-section">
		<div class="container contact-box">
			<div>
				<p class="eyebrow">STAY CONNECTED</p>
				<h2>Follow our experiments.</h2>
				<p>Join us on your favorite platform to follow along with the dev process and catch new announcements.</p>
				<!-- <p>Social and community links are placeholders for now. We’ll replace them with the official Serum 66 destinations before launch.</p> -->
			</div>
			<div class="social-grid">
				<a href="https://steamcommunity.com/groups/serum66" target="_blank" rel="noreferrer">Steam</a>
				<a href="https://www.youtube.com/@serum66games" target="_blank" rel="noreferrer">YouTube</a>
				<a href="#" target="_blank" rel="noreferrer" class="disabled-link" tabindex="-1" aria-disabled="true">Discord</a>
				<a href="https://www.twitch.tv/serum66" target="_blank" rel="noreferrer">Twitch</a>
				<a href="https://serum66games.itch.io" target="_blank" rel="noreferrer">itch.io</a>
				<a href="https://www.tiktok.com/@serum66games" target="_blank" rel="noreferrer">TikTok</a>
				<a href="https://x.com/serum66games" target="_blank" rel="noreferrer">X</a>
				
				
				
				<!-- <a href="#">Steam</a>
				<a href="#">X</a>
				<a href="#">Discord</a>
				<a href="#">YouTube</a>
				<a href="#">Instagram</a>
				<a href="#">TikTok</a>
				<a href="#">itch.io</a> -->
			</div>
		</div>
	</section>
</BaseLayout>
