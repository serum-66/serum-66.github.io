---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
---
<BaseLayout>
	<section class="hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<!-- <div class="hero-mark"><img src="/assets/logo-icon.svg" alt="" /></div>
				<p class="kicker">SERUM 66 GAMES LAB</p> -->
				<h1>Games made to be <span>different.</span></h1>
				<p class="hero-lead">We’re an indie game development studio focused on experimentation, fun, and creating new experiences for players.</p>
				<div class="hero-actions">
					<a class="button button-primary" href="#games">Explore our games</a>
					<a class="button button-ghost" href="/about">About the studio</a>
				</div>
			</div>
			<!-- <div class="hero-visual" aria-hidden="true">
				<div class="lab-orb"></div>
				<div class="lab-ring ring-a"></div>
				<div class="lab-ring ring-b"></div>
				<div class="lab-label">FORMULA 66<br /><span>EXP: UNKNOWN</span></div>
			</div> -->
			<div class="hero-visual" aria-hidden="true">
				<div class="lab-orb"></div>
		
				<div class="orbit-axis axis-a">
					<div class="lab-ring ring-a"></div>
				</div>

				<div class="orbit-axis axis-b">
					<div class="lab-ring ring-b"></div>
				</div>

				<div class="orbit-axis axis-c">
					<div class="lab-ring ring-c"></div>
				</div>

				<!--<div class="orbit-axis axis-d">
					<div class="lab-ring ring-d"></div>
				</div> -->

				<div class="lab-label">FORMULA 66<br /><span>EXP: UNKNOWN</span></div>
			</div>
		</div>
	</section>

	<section class="statement section-tight">
		<div class="container statement-inner">
			<p class="eyebrow">OUR APPROACH</p>
			<h2 >Not ordinary games.<br /><span>New experiences.</span></h2>
			<p>We like the ideas that make us stop and say, “What if?” Our goal is to take those ideas, turn them into playable experiences, and make sure they’re a hell of a lot of fun along the way.</p>
		</div>
	</section>

	<section id="games" class="section games-section">
		<div class="container">
			<div class="section-heading">
				<div>
					<p class="eyebrow">CURRENT PROJECTS</p>
					<h2>In the lab</h2>
				</div>
				<p>Two projects are currently in production. More experiments are always possible.</p>
			</div>
			<div class="games-grid">
				<GameCard
					title="Royal Guard"
					genre="Arcade Shoot 'em Up"
					status="In Production"
					description="Placeholder: a fast-paced arcade shooter built around sharp action, satisfying destruction, and replayable runs."
					href="/games/royal-guard"
				/>
				<GameCard
					title="Normal Billiards"
					genre="Billiards"
					status="In Production"
					description="Placeholder: a stylish billiards game exploring the familiar table through Serum 66’s own experimental lens."
					href="/games/normal-billiards"
				/>
			</div>
		</div>
	</section>

	<section class="section about-strip">
		<div class="container split-layout">
			<div>
				<p class="eyebrow">ABOUT SERUM 66</p>
				<h2>A small studio with a big appetite for <span>experiments.</span></h2>
			</div>
			<div>
				<p>Serum 66 Game Labs is an independent game studio built around one simple idea: games don’t have to feel ordinary.</p>
				<a class="text-link" href="/about">Learn more about us <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	<section id="contact" class="section contact-section">
		<div class="container contact-box">
			<div>
				<p class="eyebrow">STAY CONNECTED</p>
				<h2>Follow the experiments.</h2>
				<p>Social and community links are placeholders for now. We’ll replace them with the official Serum 66 destinations before launch.</p>
			</div>
			<div class="social-grid">
				<a href="#">Steam</a><a href="#">X</a><a href="#">Discord</a><a href="#">YouTube</a><a href="#">Instagram</a><a href="#">TikTok</a><a href="#">itch.io</a>
			</div>
		</div>
	</section>
</BaseLayout>
