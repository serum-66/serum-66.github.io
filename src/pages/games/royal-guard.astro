---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Royal Guard — Serum 66 Games">
	<section class="page-hero game-page-hero">
		<div class="container narrow">
			<!-- <p class="eyebrow">IN PRODUCTION · ARCADE SHOOT 'EM UP</p> -->
			 <div style="display:flex; justify-content: space-between;">
				<p class="eyebrow">ARCADE SHOOT 'EM UP</p> 
				<span class="status in-production"><span style="margin-top:2px;">IN PRODUCTION</span></span>
			 </div>
			<h1>Royal Guard</h1>
			<p>A fast-paced arcade shooter withsharp action, satisfying destruction, and replayable runs.</p>
			<a class="button button-primary" href="#">View on Steam</a>
		</div>
	</section>
	<section class="section"><div class="container media-placeholder"><span>GAMEPLAY ART PLACEHOLDER</span></div></section>
</BaseLayout>
