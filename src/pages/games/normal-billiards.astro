---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Normal Billiards — Serum 66 Games">
	<section class="page-hero game-page-hero">
		<div class="container narrow">
			<!-- <p class="eyebrow">IN PRODUCTION · BILLIARDS</p> -->
			<div style="display:flex; justify-content: space-between;">
				<p class="eyebrow">CASUAL SPORTS SIMULATION</p> 
				<span class="status in-production"><span style="margin-top:2px;">IN PRODUCTION</span></span>
			</div>
			<h1>Normal Billiards</h1>
			<p>A totally normal physics-based billiards game.</p>
			<a class="button button-primary" href="#">View on Steam</a>
		</div>
	</section>
	<section class="section"><div class="container media-placeholder"><span>GAMEPLAY ART PLACEHOLDER</span></div></section>
</BaseLayout>
